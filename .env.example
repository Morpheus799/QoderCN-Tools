# ── QoderCN Tools configuration ───────────────────────────────────────────────
# Copy to .env and edit. Real environment variables take precedence over this file.

# Inbound API-key auth. Path (relative to the project root, or absolute) to a file
# with one key per line (# starts a comment). Leave EMPTY to disable auth entirely.
# Keys may only contain letters, digits and _ - @ + = & * and be at most 50 chars;
# any other character, an over-long key, or no valid keys, fails startup.
# e.g. API_KEY_FILE=auth-keys.txt

API_KEY_FILE=

# Generated-image privacy (true/false).
#   RM_EXIF_INFO  strip the AIGC tracking metadata (provider social-credit code +
#                 per-image tracking IDs) — lossless.
#   RM_BLIND_WM   destroy the invisible blind watermark's payload via a geometric
#                 desync + lossy re-encode — changes pixels slightly.
RM_EXIF_INFO=true
RM_BLIND_WM=false

# Feature routes. Each variable exposes one tool at the given path. Comment a line
# out to NOT expose that tool. At least one must be set. Paths must be unique and
# must not collide with reserved paths (/health, /docs, /openapi.json, /redoc).
IMAGEGEN_URL=/imageGen
WEBSEARCH_URL=/webSearch
IMAGESEARCH_URL=/imageSearch

# Network. IP is the bind/exposure surface (127.0.0.1 = local only,
# 0.0.0.0 = all interfaces). PORT is the listen port; -1 auto-picks a free port;
# an occupied port fails startup.
IP=127.0.0.1
PORT=8790

# ── Advanced (optional) ───────────────────────────────────────────────────────
# Upstream gateway host. Default is gateway.qoder.com.cn (QoderCN personal accounts);
# enterprise Lingma uses lingma.alibabacloud.com.
#QODERCN_BASE_URL=https://gateway.qoder.com.cn
# Explicit plaintext credential file; otherwise the QoderCN CLI login cache is used.
#QODERCN_AUTH_FILE=
# Point at the QoderCN CLI cache dir explicitly (else standard locations are scanned).
#LINGMA_CACHE_DIR=
# Proxy upstream calls (e.g. mitmproxy) for debugging.
#QODERCN_UPSTREAM_PROXY=http://127.0.0.1:8080
#QODERCN_COSY_VERSION=2.11.2
#QODERCN_TIMEOUT=60
